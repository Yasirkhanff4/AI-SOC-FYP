# Application secrets — create `.env` locally from this file.
# Never commit `.env` or real provider keys.
DATABASE_URL=sqlite:///./ai_soc.db
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=true
DEMO_MODE=true
USE_MOCK_THREAT_INTEL=true
LLM_PROVIDER=local
LLM_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
POSTGRES_DB=ai_soc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-for-local-compose
VITE_API_URL=http://localhost:8000
